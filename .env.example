# ============================================================
# API Vault - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-very-long-random-string-in-production

# --- PostgreSQL ---
DATABASE_URL=postgresql://vault_user:vault_pass@localhost:5432/api_vault

# --- JWT ---
JWT_SECRET_KEY=another-super-secret-jwt-key-change-me
JWT_ACCESS_TOKEN_EXPIRES=3600        # seconds (1h)
JWT_REFRESH_TOKEN_EXPIRES=604800     # seconds (7d)

# --- HashiCorp Vault ---
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=your-vault-root-token
VAULT_SSH_ROLE=my-role
VAULT_KV_MOUNT=secret               # KV v2 mount path
VAULT_SSH_MOUNT=ssh                 # SSH secrets engine mount

# --- Admin Account (first run) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# --- Rate Limiting ---
RATELIMIT_DEFAULT=100 per minute
RATELIMIT_STORAGE_URL=memory://

# --- CORS ---
CORS_ORIGINS=*
